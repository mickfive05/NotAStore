# Copia questo file come .env e inserisci le credenziali del tuo provider email.
# Non pubblicare mai il file .env e non inserirlo nel controllo versione.
NODE_ENV=production

# Register.it — casella mittente dedicata agli accrediti virtuali
SMTP_HOST=authsmtp.securemail.pro
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=accrediti@notastore.shop
SMTP_PASS=replace-with-register-mailbox-password
SMTP_FROM=NotAStore Accrediti <accrediti@notastore.shop>

# Indirizzo pubblico del sito, usato nei link di accredito inviati via email.
PUBLIC_BASE_URL=https://notastore.shop

# Su Render questo percorso coincide con il disco persistente definito in render.yaml
NOTASTORE_DB_FILE=/var/data/notastore.json

# Gli accrediti automatici a intervalli restano spenti in produzione.
# Gli accrediti inviati manualmente dalla console admin continuano a funzionare.
NOTASTORE_ENABLE_SCHEDULED_CREDITS=false

# Codice pubblicato periodicamente nella bio o nei contenuti social.
# Cambialo a ogni campagna; non inserirlo nel codice sorgente pubblico.
NOTASTORE_SOCIAL_CODE=replace-with-a-private-campaign-code
